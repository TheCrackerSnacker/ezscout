{
  "name": "ezscout",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "npm test --workspaces --if-present",
    "test:integration": "npm run test:integration -w @ezscout/api",
    "test:e2e": "npm run test -w @ezscout/e2e",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "dev:api": "npm run dev -w @ezscout/api",
    "dev:web": "npm run dev -w @ezscout/web"
  },
  "devDependencies": {
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript-eslint": "^8.67.0"
  }
}
