{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp"],
      "enabled": true
    },
    "visor": {
      "type": "local",
      "command": ["npx", "-y", "visor-mcp"],
      "enabled": true,
      "environment": {
        "VISOR_MCP_BASE_URL": "{env:VISOR_MCP_BASE_URL}",
        "VISOR_MCP_API_KEY": "{env:VISOR_MCP_API_KEY}",
        "VISOR_MCP_MODEL": "{env:VISOR_MCP_MODEL}"
      }
    }
  }
}